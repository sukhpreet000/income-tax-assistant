{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/login.php", "destination": "/login.html" },
    { "source": "/register.php", "destination": "/register.html" },
    { "source": "/dashboard.php", "destination": "/dashboard.html" },
    { "source": "/income.php", "destination": "/income.html" },
    { "source": "/deductions.php", "destination": "/deductions.html" },
    { "source": "/calculator.php", "destination": "/calculator.html" },
    { "source": "/checklist.php", "destination": "/checklist.html" },
    { "source": "/history.php", "destination": "/history.html" },
    { "source": "/profile.php", "destination": "/profile.html" },
    { "source": "/index.php", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/income", "destination": "/income.html" },
    { "source": "/deductions", "destination": "/deductions.html" },
    { "source": "/calculator", "destination": "/calculator.html" },
    { "source": "/checklist", "destination": "/checklist.html" },
    { "source": "/history", "destination": "/history.html" },
    { "source": "/profile", "destination": "/profile.html" }
  ]
}
